# LLM provider (required) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Shared memory (optional — falls back to in-process memory when empty)
REDIS_URL=

# Ad platform API (optional — leave blank to run in mock mode with sample data)
AD_PLATFORM_APP_ID=
AD_PLATFORM_APP_SECRET=
AD_PLATFORM_ACCESS_TOKEN=

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ad-ops-agent
