# Default: deterministic demo provider. No key, no network, nothing to fill in.
LLM_PROVIDER=demo

# Optional live provider (opt-in). The key is read as a secret and never logged.
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Where the two SQLite files live (app store + LangGraph checkpoints). Default: ./data
# DATA_DIR=./data

# Limits (defaults shown)
# PROVIDER_TIMEOUT_S=20
# PROVIDER_MAX_ATTEMPTS=2
# MAX_RECOVERIES=3
# MAX_ACTIVE_RUNS=4
